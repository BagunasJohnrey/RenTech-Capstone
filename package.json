{
  "name": "rentech-fullstack",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\" --names \"BACKEND,FRONTEND\" --prefix name",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:watch": "nodemon --watch backend/src --watch frontend/src --exec \"npm run dev\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "nodemon": "^3.1.14"
  }
}
