generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  Admin
  Staff
  Customer
}

enum ItemStatus {
  Available
  Rented
  Reserved
  Cleaning
  OutOfService
  Deleted
}

enum TransactionStatus {
  Active
  Overdue
  Reserved
  Returned
  Cancelled
}

model Profile {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  email      String   @unique
  role       Role     @default(Customer)
  name       String
  phone      String?
  address    String?
   preferences String?  @map("preferences")
   notifyPrefs Json?    @map("notify_prefs")
   styleNotes  String?  @map("style_notes")
   mfaEnabled  Boolean  @default(false) @map("mfa_enabled")
   totpSecret  String?  @map("totp_secret")
   backupCodes Json?    @map("backup_codes")
   mustChangePassword Boolean @default(false) @map("must_change_password")
   avatarPath String? @map("avatar_path")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customerTransactions Transaction[]    @relation("CustomerTransactions")
  processedByTransactions Transaction[] @relation("ProcessedByTransactions")
  assistedTransactions Transaction[] @relation("AssistedTransactions")
  releasedTransactions Transaction[] @relation("ReleasedTransactions")
  notifications  Notification[]
  sentMessages   SentSms[]              @relation("SentMessages")
  sentByMessages SentSms[]              @relation("SentByMessages")
  emailTokens    EmailToken[]
  importedRecords HistoricalRecord[] @relation("ImportedRecords")
  reviewedProofs PaymentProof[] @relation("ProofReviewer")

  @@map("profiles")
}

model InventoryItem {
  id          Int        @id @default(autoincrement())
  name        String
  category    String
  occasions   String[]   @default([])
  // Staff-only color tags (never rendered on cards) — powers the catalog
  // Colors filter, text search, and RAG color matching ("green theme gowns").
  colors      String[]   @default([])
  price       Float
  status      ItemStatus @default(Available)
  image       String?
  description String?
  size        String?
  onSale      Boolean    @default(false) @map("on_sale")
  discountPct Float?     @map("discount_pct")
  salePrice   Float?     @map("sale_price")
  saleEndsAt  DateTime?  @map("sale_ends_at")
  outOfServiceReason String? @map("out_of_service_reason")
  // Tier 2 RAG: dense embedding (Gemini text-embedding-004, 768-dim).
  // NULL until the offline reindex runs. Raw SQL (match_chunks RPC) reads it
  // so retrieval works even before `prisma generate` picks up this column.
  embedding Unsupported("vector(768)")?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  transactions Transaction[]

  @@index([name, category, status])
  @@map("inventory_items")
}

// Tier 2 RAG: semantic knowledge index (pgvector, HNSW). One chunk per
// inventory item (source='inventory', sourceId=item id), one per BusinessRule
// (source='rule'), one per SmsTemplate (source='template'). Written ONLY by
// the offline ingestion path (scripts/reindex-knowledge.ts, POST /ai/reindex)
// — never on the chat request path.
model KnowledgeChunk {
  // Native UUID PK to match prisma/rag_pgvector.sql (Prisma's uuid() default
  // would be TEXT and `db push` would try to rewrite the live PK column).
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source    String
  sourceId  String?  @map("source_id")
  chunk     String
  embedding Unsupported("vector(768)")?
  metadata  Json?
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([source, sourceId])
  @@map("knowledge_chunks")
}

model Transaction {
  id              String            @id @default(uuid())
  txNumber        Int               @default(autoincrement()) @map("tx_number")
  customerId      String            @map("customer_id")
  processedById   String?           @map("processed_by_id")
  // Staff who created/assisted the booking (set once at create, never overwritten).
  assistedById    String?           @map("assisted_by_id")
  // Staff who physically released the item at pickup (set once at release).
  releasedById    String?           @map("released_by_id")
  itemId          Int               @map("item_id")
  promoCodeId     String?           @map("promo_code_id")
  // Staff counter discount (admin-PIN approved at booking): percent applied
  // server-side + approver name for the audit trail. Null = no staff discount.
  staffDiscountPct Float?          @map("staff_discount_pct")
  staffDiscountBy  String?         @map("staff_discount_by")
  rentalDate      DateTime          @map("rental_date")
  dueDate         DateTime          @map("due_date")
  returnDate      DateTime?         @map("return_date")
  status          TransactionStatus @default(Active)
  rentalFee       Float             @map("rental_fee")
  downpayment     Float             @default(0)
  latePenalty     Float             @default(0) @map("late_penalty")
  damageFee       Float             @default(0) @map("damage_fee")
  totalPaid       Float             @default(0) @map("total_paid")
  balance         Float
  conditionPhoto  String?           @map("condition_photo")
  releasePhoto    String?           @map("release_photo")
  returnPhoto     String?           @map("return_photo")
  dueReminderSent Boolean           @default(false) @map("due_reminder_sent")
  // Email once-guards (independent of the SMS flags above). The scheduler used
  // to gate reminder emails on the SMS delivery flags, so any transaction
  // whose SMS kept failing (bad phone, SMS outage) re-sent its Brevo email
  // every 60s tick indefinitely. Each email now flips its own flag on send.
  dueReminderEmailSent      Boolean @default(false) @map("due_reminder_email_sent")
  noShowNotified  Boolean           @default(false) @map("no_show_notified")
  overdueSmsSent        Boolean     @default(false) @map("overdue_sms_sent")
  overdueSmsRetried     Boolean     @default(false) @map("overdue_sms_retried")
  overdueEscalationSent Boolean     @default(false) @map("overdue_escalation_sent")
  overdueEmailSent          Boolean @default(false) @map("overdue_email_sent")
  overdueEscalationEmailSent Boolean @default(false) @map("overdue_escalation_email_sent")
  damageReason    String?           @map("damage_reason")
  notes           String?
  // Garment alteration workflow: null = no alteration needed,
  // 'pending' = with tailor, 'ready' = fitted, customer may pick up.
  alterationStatus String?          @map("alteration_status")
  size            String?           @map("size")
  measurements    Json?             @map("measurements")
  gateway          String?          @map("gateway")
  gatewayPaymentId String?          @map("gateway_payment_id")
  // Which checkout path this booking was created through. 'manual' = static
  // QR + staff-reviewed proof (drives the awaiting-proof chase list).
  paymentPath     String?           @map("payment_path")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  customer      Profile        @relation("CustomerTransactions", fields: [customerId], references: [id])
  processedBy   Profile?       @relation("ProcessedByTransactions", fields: [processedById], references: [id])
  assistedBy    Profile?       @relation("AssistedTransactions", fields: [assistedById], references: [id], onDelete: SetNull)
  releasedBy    Profile?       @relation("ReleasedTransactions", fields: [releasedById], references: [id], onDelete: SetNull)
  item          InventoryItem  @relation(fields: [itemId], references: [id])
  promoCode     PromoCode?     @relation(fields: [promoCodeId], references: [id])
  notifications Notification[]
  payments      Payment[]
  paymentProofs PaymentProof[]
  sentSms       SentSms[]

  @@index([itemId, status])
  @@index([customerId, status])
  @@index([status, dueDate])
  @@index([processedById])
  @@index([assistedById])
  @@index([releasedById])
  @@index([createdAt])
  @@map("transactions")
}

model PromoCode {
  id          String   @id @default(uuid())
  code        String   @unique
  // Exactly one of the two is set (enforced in service + zod): percent off
  // (1–100) or a fixed peso amount off.
  discountPct Float?   @map("discount_pct")
  discountAmount Float? @map("discount_amount")
  // Optional guards: minimum rental fee, start date, per-customer cap
  // (null = once, the historical behavior), first-timers only, and category
  // scoping (empty = all categories).
  minSpend    Float?   @map("min_spend")
  startsAt    DateTime? @map("starts_at")
  maxUsesPerCustomer Int? @map("max_uses_per_customer")
  firstBookingOnly Boolean @default(false) @map("first_booking_only")
  appliesToCategories String[] @default([]) @map("applies_to_categories")
  maxUses     Int?     @map("max_uses")
  currentUses Int      @default(0) @map("current_uses")
  expiresAt   DateTime? @map("expires_at")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  transactions Transaction[]

  @@map("promo_codes")
}

// Imported historical rental records (paper logbooks, pre-system walk-ins).
// ANALYTICAL ONLY: feeds the demand forecast + category split. Deliberately
// NOT Transaction rows — real transactions drive availability, revenue KPIs
// and the reminder scheduler, so synthetic history rows there would corrupt
// operations (and spam overdue reminders for every past-due import).
model HistoricalRecord {
  id           String   @id @default(uuid())
  customerName String?  @map("customer_name")
  category     String
  address      String
  eventDate    DateTime @map("event_date")
  price        Float
  source       String   @default("import")
  importedById String?  @map("imported_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  importedBy Profile? @relation("ImportedRecords", fields: [importedById], references: [id], onDelete: SetNull)

  @@index([eventDate])
  @@index([category])
  @@map("historical_records")
}

model Payment {
  id            String   @id @default(uuid())
  transactionId String   @map("transaction_id")
  amount        Float
  method        String
  type          String
  gateway    String   @default("paymongo")
  gatewayRef String?  @unique @map("gateway_ref")
  status        String   @default("pending")
  createdAt     DateTime @default(now()) @map("created_at")

  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@index([transactionId])
  @@index([createdAt])
  @@map("payments")
}

// Customer-submitted manual-QR payment evidence (screenshot + reference).
// Approval is the only event that credits money; it flows through
// payments.ledger.ts with gatewayRef = 'proof_<id>' so a double-approve is
// idempotent. Rejection moves nothing and allows a new submission.
model PaymentProof {
  id              String    @id @default(uuid())
  transactionId   String    @map("transaction_id")
  amount          Float
  reference       String?
  channel         String?
  imagePath       String    @map("image_path")
  status          String    @default("pending")
  rejectionReason String?   @map("rejection_reason")
  reviewedById    String?   @map("reviewed_by_id")
  reviewedAt      DateTime? @map("reviewed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  transaction Transaction @relation(fields: [transactionId], references: [id])
  reviewedBy  Profile?    @relation("ProofReviewer", fields: [reviewedById], references: [id])

  @@index([status, createdAt])
  @@index([transactionId])
  @@index([reviewedById])
  @@map("payment_proofs")
}

model Notification {
  id            String   @id @default(uuid())
  profileId     String   @map("profile_id")
  transactionId String?  @map("transaction_id")
  type          String
  title         String
  message       String
  isRead        Boolean  @default(false) @map("is_read")
  createdAt     DateTime @default(now()) @map("created_at")

  profile     Profile?     @relation(fields: [profileId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@index([profileId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model SentSms {
  id            String   @id @default(uuid())
  profileId     String   @map("profile_id")
  sentById      String?  @map("sent_by_id")
  transactionId String?  @map("transaction_id")
  templateId    String?  @map("template_id")
  message       String
  status        String   @default("sent")
  createdAt     DateTime @default(now()) @map("created_at")

  profile     Profile      @relation("SentMessages", fields: [profileId], references: [id])
  sentBy      Profile?     @relation("SentByMessages", fields: [sentById], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])
  template    SmsTemplate? @relation(fields: [templateId], references: [id])

  @@index([profileId])
  @@index([createdAt])
  @@map("sent_sms")
}

model SmsTemplate {
  id        String   @id @default(uuid())
  name      String
  content   String
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages SentSms[]

  @@map("sms_templates")
}

model BusinessRule {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("business_rules")
}

model AuditLog {
  id            String   @id @default(uuid())
  action        String
  entity        String
  entityId      String   @map("entity_id")
  performedById String?  @map("performed_by_id")
  oldValue      Json?    @map("old_value")
  newValue      Json?    @map("new_value")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

// Single-use email tokens for Brevo-delivered flows (signup verification +
// password reset). Supabase still owns the auth credential — this table only
// proves "the holder of this inbox clicked the link" without routing email
// through Supabase's own SMTP.
model EmailToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  type      String
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId, type])
  @@map("email_tokens")
}
