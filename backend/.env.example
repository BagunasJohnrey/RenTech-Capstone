# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key

# Database (via Supabase connection pooler, port 6543 + PgBouncer-compat flags)
DATABASE_URL=postgresql://postgres:password@xxxxx.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Direct connection (port 5432, user `postgres` — NOT postgres.<ref>): used by
# prisma db push / migrate / db execute. The transaction-mode pooler URL above
# HANGS at the advisory-lock step, so DDL must route to this direct host.
DIRECT_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres

# Supabase
# Project JWT secret (Settings → API → JWT Settings). Empty = skip local JWT verify.
SUPABASE_JWT_SECRET=your_jwt_secret
# W3.9: AES-256-GCM key for encrypting TOTP secrets at rest. Generate with:
#   openssl rand -base64 32
MFA_SECRET_KEY=your_base64_32_byte_key

# Semaphore
SEMAPHORE_API_KEY=your_semaphore_api_key

# Gemini
GEMINI_API_KEY=your_gemini_api_key

# Groq (optional — fallback tier 2, tried after Gemini)
GROQ_API_KEY=your_groq_api_key

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Extra browser origins allowed for CORS + the CSRF guard (comma-separated,
# optional). Needed after a domain migration: old shared/bookmarked links keep
# working instead of 403ing on login. www/apex twins are added automatically.
# Example: ALLOWED_ORIGINS=https://rentech-myleneboutique.vercel.app
ALLOWED_ORIGINS=
# false (default) = signups require email confirmation (Supabase sends the
# verification email; accounts can't log in until verified). Set to true to
# auto-confirm signups for a frictionless demo/offline dev.
AUTH_EMAIL_CONFIRM=false
