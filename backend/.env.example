# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key

# Database (via Supabase connection pooler, port 6543 + PgBouncer-compat flags)
DATABASE_URL=postgresql://postgres:password@xxxxx.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Direct connection (port 5432, user `postgres` — NOT postgres.<ref>): used by
# prisma db push / migrate / db execute. The transaction-mode pooler URL above
# HANGS at the advisory-lock step, so DDL must route to this direct host.
DIRECT_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres

# PayMongo
PAYMONGO_SECRET_KEY=sk_test_xxxxx
PAYMONGO_PUBLIC_KEY=pk_test_xxxxx
PAYMONGO_WEBHOOK_SECRET=whsec_xxxxx

# Semaphore
SEMAPHORE_API_KEY=your_semaphore_api_key

# Gemini
GEMINI_API_KEY=your_gemini_api_key

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
